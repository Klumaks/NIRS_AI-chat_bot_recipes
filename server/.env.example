# Скопируйте в server/.env и заполните. Файл .env не коммитится.

# --- LLM: любой OpenAI-совместимый Chat Completions API ---
# none — вопросы по рецепту возвращают 503 LLM_UNAVAILABLE (подбор и рецепты работают)
CHEF_LLM_PROVIDER=none
# Локально и бесплатно: Ollama (https://ollama.com), затем `ollama pull qwen2.5:7b`
# CHEF_LLM_PROVIDER=openai_compatible
# CHEF_LLM_BASE_URL=http://127.0.0.1:11434/v1
# CHEF_LLM_MODEL=qwen2.5:7b
# CHEF_LLM_API_KEY=
# Облачный провайдер (пример OpenRouter):
# CHEF_LLM_BASE_URL=https://openrouter.ai/api/v1
# CHEF_LLM_MODEL=<модель провайдера>
# CHEF_LLM_API_KEY=<ключ — только здесь, не в Git>
# Если провайдер не понимает response_format=json_object:
# CHEF_LLM_JSON_MODE=false

# --- Поиск ---
# По умолчанию search/data/corpus.jsonl, если собран; иначе выборка sample_corpus.jsonl (без шагов)
# CHEF_CORPUS_PATH=../search/data/sample_corpus.jsonl
# CHEF_SEARCH_MODE=lemma

# --- Хранилище и сессии ---
# CHEF_DB_PATH=data/chef.sqlite3
# CHEF_SESSION_TTL_HOURS=168
# CHEF_SESSION_IDLE_HOURS=24
# CHEF_COOKIE_SECURE=false          # true при HTTPS
# CHEF_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000
